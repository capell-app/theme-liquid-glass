{
    "manifest-version": 3,
    "name": "capell-app/theme-liquid-glass",
    "slug": "theme-liquid-glass",
    "displayName": "Theme Liquid Glass",
    "kind": "theme",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "launchStatus": "hidden",
    "description": "Three looks called Clarity, Prism and Graphite, and eight extra blocks, most of them on frosted see-through panels.",
    "product": {
        "group": "Capell Themes",
        "tier": "free",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeLiquidGlass",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": [
            "capell-app/core",
            "capell-app/theme-foundation",
            "capell-app/frontend",
            "capell-app/layout-builder"
        ],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [
            "Capell\\ThemeLiquidGlass\\LiquidGlassThemeServiceProvider"
        ],
        "install": [
            "Capell\\ThemeLiquidGlass\\Providers\\ConsoleServiceProvider"
        ],
        "runtime": [
            "Capell\\ThemeLiquidGlass\\LiquidGlassThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeLiquidGlass\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "liquid-glass"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-liquid-glass-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true,
            "cacheSafe": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "criticalCss": {
            "required": true,
            "parityViewports": ["mobile", "tablet", "desktop"]
        },
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-liquid-glass"],
        "cacheSafety": {
            "cacheable": true,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\Core\\Models\\Page",
                    "events": ["saved", "deleted"]
                },
                {
                    "model": "Capell\\Core\\Models\\PageUrl",
                    "events": ["saved", "deleted"]
                },
                {
                    "model": "Capell\\Core\\Models\\SiteDomain",
                    "events": ["saved", "deleted"]
                },
                {
                    "model": "Capell\\Core\\Models\\Translation",
                    "events": ["saved", "deleted"]
                },
                {
                    "model": "Capell\\Core\\Models\\Layout",
                    "events": ["saved", "deleted"]
                },
                {
                    "model": "Capell\\LayoutBuilder\\Models\\Widget",
                    "events": ["saved", "deleted"]
                }
            ],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-liquid-glass.package-health",
            "label": "Theme Liquid Glass package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeLiquidGlass\\Health\\ThemeLiquidGlassHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "Pale mint, pale blue or near-black pages, with frosted cards, counting figures and shortcut links in the theme's own blocks.",
        "description": "Pick one of three looks, pale mint, pale blue or near-black, and add frosted-panel blocks for calls to action, showcases and counting figures. Editors add each block's wording in the widget editor, and the theme needs the Foundation theme and Layout Builder installed first.",
        "problem": "Our pages feel flat and I want a layered, soft look without commissioning a custom design.",
        "outcome": "Your pages get frosted cards, figures and shortcut links, with a soft blur behind them, in the colours you picked.",
        "faq": [
            {
                "question": "What else do I need installed before I use Liquid Glass?",
                "answer": "You need the Foundation theme and Layout Builder, the page builder you place blocks with. Sections that come from Foundation keep their ordinary look and do not get the frosted panels."
            },
            {
                "question": "Can I try it before visitors see it?",
                "answer": "Yes. A private preview shows your own pages in the theme, and visitors keep seeing the current theme until you apply it."
            },
            {
                "question": "What do the blocks show before I write their wording?",
                "answer": "Four of the blocks show built-in sample headings until you fill in your own wording in the editing form. The footer builds its copyright line from your site title and the year."
            },
            {
                "question": "Does Liquid Glass have a dark version?",
                "answer": "Yes, for visitors whose device is set to dark. The header and the panels in the eight blocks turn dark in all three looks."
            }
        ],
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.svg",
                "alt": "An abstract card with a frosted white panel, a teal bar, grey text lines, an orange button and a round shape on pale mint",
                "caption": "A preview card for the theme, drawn as shapes with no page content."
            },
            {
                "path": "docs/screenshots/liquid-glass-homepage.webp",
                "alt": "A launch page on pale mint with frosted cards, a large photo of two people at laptops, a figures strip and project cards",
                "caption": "The home page uses see-through panels, a figures strip and a call to action."
            },
            {
                "path": "docs/screenshots/liquid-glass-directory.webp",
                "alt": "A page of three project cards with photos, short summaries and one large figure each, above a grey-blue call to action band",
                "caption": "Cards sit on soft panels, each with a photo, a summary and one figure."
            },
            {
                "path": "docs/screenshots/liquid-glass-detail.webp",
                "alt": "A page of three project cards with photos and figures above a grey-blue call to action band and a footer",
                "caption": "A second content page built from the same card block, with the same call to action below."
            },
            {
                "path": "docs/screenshots/liquid-glass-empty.webp",
                "alt": "A page headed No results with a short line of text above a grey-blue call to action band and a footer",
                "caption": "What visitors see when a filtered list has nothing in it."
            },
            {
                "path": "docs/screenshots/liquid-glass-contact.webp",
                "alt": "A page headed Get in touch with a short line of text above a grey-blue call to action band with two buttons and a footer",
                "caption": "A contact page that points visitors to two buttons and has no form of its own."
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "liquid-glass",
    "contributionTraceability": {
        "contributions": [
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.liquid-glass.cta",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.liquid-glass.floating-glass-nav",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.liquid-glass.glass-feature-card",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.liquid-glass.layered-depth-hero",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.liquid-glass.presets",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.liquid-glass.refraction-grid",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.liquid-glass.showcase",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.liquid-glass.translucent-stat-band",
                "providerBucket": "runtime"
            },
            {
                "type": "model",
                "key": "model-interceptor:Capell\\Core\\Models\\Theme:Capell\\ThemeLiquidGlass\\Support\\Interceptors\\Themes\\LiquidGlassThemeInterceptor:liquid-glass",
                "providerBucket": "runtime"
            }
        ]
    }
}
