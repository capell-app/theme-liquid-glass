{
    "manifest-version": 3,
    "name": "capell-app/theme-liquid-glass",
    "slug": "theme-liquid-glass",
    "displayName": "Theme Liquid Glass",
    "kind": "theme",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "description": "Theme Liquid Glass gives Capell sites a free modern glass interface with translucent panels, crisp typography, and warm accent actions. Three presets cover bright product launches, editorial glass pages, and darker graphite surfaces while staying fully driven by Theme Studio tokens. It renders through the shared layout-builder container pipeline, keeps public output cache-safe and editor-free, and adds a polished alternative to the Foundation and Corporate free lanes.",
    "product": {
        "group": "Capell Themes",
        "tier": "free",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeLiquidGlass",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": [
            "capell-app/core",
            "capell-app/theme-foundation",
            "capell-app/frontend",
            "capell-app/layout-builder"
        ],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeLiquidGlass\\LiquidGlassThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeLiquidGlass\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "liquid-glass"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-liquid-glass-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-liquid-glass", "theme-liquid-glass-frontend"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "criticalCss": {
            "required": true,
            "parityViewports": ["mobile", "tablet", "desktop"]
        },
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-liquid-glass"],
        "cacheSafety": {
            "cacheable": true,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\Core\\Models\\Page",
                    "events": ["saved", "deleted"]
                },
                {
                    "model": "Capell\\Core\\Models\\PageUrl",
                    "events": ["saved", "deleted"]
                },
                {
                    "model": "Capell\\Core\\Models\\SiteDomain",
                    "events": ["saved", "deleted"]
                },
                {
                    "model": "Capell\\Core\\Models\\Translation",
                    "events": ["saved", "deleted"]
                },
                {
                    "model": "Capell\\Core\\Models\\Layout",
                    "events": ["saved", "deleted"]
                },
                {
                    "model": "Capell\\LayoutBuilder\\Models\\Widget",
                    "events": ["saved", "deleted"]
                }
            ],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-liquid-glass.package-health",
            "label": "Theme Liquid Glass package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeLiquidGlass\\Health\\ThemeLiquidGlassHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "A free glass interface theme for modern Capell sites with translucent panels, sharp content rhythm, and three token-driven presets.",
        "description": "Theme Liquid Glass gives Capell sites a free modern glass interface with translucent panels, crisp typography, and warm accent actions. Three presets cover bright product launches, editorial glass pages, and darker graphite surfaces while staying fully driven by Theme Studio tokens. It renders through the shared layout-builder container pipeline, keeps public output cache-safe and editor-free, and adds a polished alternative to the Foundation and Corporate free lanes.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.svg",
                "alt": "Theme Liquid Glass marketplace card.",
                "caption": "Theme Liquid Glass free theme card."
            },
            {
                "path": "docs/screenshots/liquid-glass-homepage.png",
                "alt": "Theme Liquid Glass homepage rendered through the package theme shell.",
                "caption": "Runner-backed homepage preview with layered glass panels."
            },
            {
                "path": "docs/screenshots/liquid-glass-directory.png",
                "alt": "Theme Liquid Glass directory rendered with layered content cards.",
                "caption": "Runner-backed directory with layered glass panels."
            },
            {
                "path": "docs/screenshots/liquid-glass-detail.png",
                "alt": "Theme Liquid Glass detail page rendered with translucent content cards.",
                "caption": "Runner-backed detail preview with translucent cards."
            },
            {
                "path": "docs/screenshots/liquid-glass-empty.png",
                "alt": "Theme Liquid Glass empty state rendered inside a clear glass panel.",
                "caption": "Runner-backed empty-state proof with a clear recovery path."
            },
            {
                "path": "docs/screenshots/liquid-glass-contact.png",
                "alt": "Theme Liquid Glass contact page rendered with conversion-focused actions.",
                "caption": "Runner-backed contact preview with conversion-focused actions."
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "liquid-glass"
}
